generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles: public registration is always CUSTOMER.
enum Role {
  CUSTOMER
  SUPPORT_AGENT
  ADMIN
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  // Stored normalized (trimmed + lower-cased) for case-insensitive uniqueness.
  email        String   @unique @db.VarChar(255)
  // Only ever a bcrypt hash.
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens      RefreshToken[]
  knowledgeDocuments KnowledgeDocument[]
  chatLogs           ChatLog[]

  @@index([role])
  @@map("users")
}

// Opaque random token; only its SHA-256 hash is stored.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model KnowledgeDocument {
  id          String         @id @default(uuid()) @db.Uuid
  title       String         @db.VarChar(300)
  source      String?        @db.VarChar(1024)
  sourceType  String?        @map("source_type") @db.VarChar(40)
  mimeType    String?        @map("mime_type") @db.VarChar(120)
  checksum    String?        @unique @db.Char(64)
  status      DocumentStatus @default(PENDING)
  metadata    Json?
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  chunks    DocumentChunk[]

  @@index([status])
  @@map("knowledge_documents")
}

model DocumentChunk {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  chunkIndex Int      @map("chunk_index")
  content    String   @db.Text
  tokenCount Int?     @map("token_count")
  metadata   Json?
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime @default(now()) @map("created_at")

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@map("document_chunks")
}

// How a chat question was handled; drives the staff analytics.
enum ChatOutcome {
  ANSWERED // the assistant answered from the knowledge base
  NOT_SPECIFIED // related material exists but does not answer the question
  NO_EVIDENCE // nothing relevant passed the similarity gate
  ACTION_UNAVAILABLE // the customer asked for an action the assistant cannot perform
  FAILED // retrieval or generation failed
}

// One row per question asked in the assistant, for staff analytics.
model ChatLog {
  id            String      @id @default(uuid()) @db.Uuid
  // Kept when the account is deleted (set to null) so totals stay correct.
  userId        String?     @map("user_id") @db.Uuid
  question      String      @db.Text
  answer        String?     @db.Text
  outcome       ChatOutcome
  sourceCount   Int         @default(0) @map("source_count")
  topSimilarity Float?      @map("top_similarity")
  // Documents cited by the answer (no foreign key: documents may be deleted later).
  documentIds   String[]    @default([]) @map("document_ids") @db.Uuid
  latencyMs     Int         @map("latency_ms")
  createdAt     DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([outcome, createdAt])
  @@index([userId])
  @@map("chat_logs")
}
