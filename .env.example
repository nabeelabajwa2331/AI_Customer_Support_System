# ---- Application ----
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:3000

# ---- Database (PostgreSQL 18) ----
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/ai_customer_support?schema=public"
# Required by the automated test suite. Use a dedicated test database (not the
# main database or its legacy `test` schema). The database name must differ from
# DATABASE_URL. Create it before running tests, for example:
#   createdb ai_customer_support_test
TEST_DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/ai_customer_support_test"

# ---- Ollama (local AI) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSIONS=768
# Request timeout for local model calls (milliseconds).
OLLAMA_TIMEOUT_MS=30000

# ---- Auth / Session ----
# Secret used to sign JWT access tokens. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=CHANGE_ME
# Short-lived access token lifetime (e.g. 15m, 1h).
JWT_EXPIRES_IN=15m
# Refresh token lifetime in days (stored server-side so it can be revoked).
REFRESH_TOKEN_TTL_DAYS=7
# bcrypt cost factor (10-15).
BCRYPT_ROUNDS=12

# ---- Logging ----
LOG_LEVEL=info
