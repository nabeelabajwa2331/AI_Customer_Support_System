# ---- Application ----
NODE_ENV=development
PORT=5001
APP_BASE_URL=http://localhost:3000

# ---- Database (PostgreSQL 18) ----
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/ai_customer_support?schema=public"
# Required by the automated test suite. Use a dedicated test database (not the
# main database or its legacy `test` schema). The database name must differ from
# DATABASE_URL. Create it before running tests, for example:
#   createdb ai_customer_support_test
TEST_DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/ai_customer_support_test"

# ---- Ollama (local AI) ----
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:3b needs roughly 3 GB of free RAM while loading. On an 8 GB machine
# with limited free memory, use qwen2.5:0.5b or close other applications first.
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSIONS=768
# Request timeout for embedding calls (milliseconds).
OLLAMA_TIMEOUT_MS=30000
# Request timeout for chat generation (milliseconds). Longer because loading
# the chat model from cold can take 25-35s on CPU-only machines. The server also
# loads both models in the background at startup.
OLLAMA_CHAT_TIMEOUT_MS=120000
# Chat relevance gate: retrieved chunks with similarity (1 - cosine distance)
# below this value are not sent to the chat model. If none pass, the API returns
# a fixed "not enough information" answer without calling the model.
# Must be between 0 and 1. 0.40 is provisional, taken from a small evaluation
# against a single test document; re-measure it as the knowledge base grows.
# Similarity measures topic closeness, not whether the document answers the question.
CHAT_MIN_SIMILARITY=0.40
# Per-user request limits for the expensive AI routes (HTTP 429 when exceeded).
# Raise temporarily only for automated evaluation runs.
CHAT_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_HOUR=20

# ---- Auth / Session ----
# Secret used to sign JWT access tokens. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=CHANGE_ME
# Short-lived access token lifetime (e.g. 15m, 1h).
JWT_EXPIRES_IN=15m
# Refresh token lifetime in days (stored server-side so it can be revoked).
REFRESH_TOKEN_TTL_DAYS=7
# bcrypt cost factor (10-15).
BCRYPT_ROUNDS=12

# ---- Google sign-in (optional) ----
# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console.
# Not a secret. Add http://localhost:5173 to its Authorized JavaScript origins.
# Leave empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=

# ---- Logging ----
LOG_LEVEL=info
