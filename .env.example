# ---- Application ----
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:3000

# ---- Database (PostgreSQL 18) ----
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/ai_customer_support?schema=public"
# Optional: isolated target used only by the automated test suite. It points at
# a separate schema so tests never touch development data.
TEST_DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/ai_customer_support?schema=test"

# ---- AI Provider ----
AI_PROVIDER=openai
AI_API_KEY=CHANGE_ME
AI_MODEL=CHANGE_ME
AI_MAX_TOKENS=1024

# ---- Auth / Session ----
# Secret used to sign JWT access tokens. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=CHANGE_ME
# Short-lived access token lifetime (e.g. 15m, 1h).
JWT_EXPIRES_IN=15m
# Refresh token lifetime in days (stored server-side so it can be revoked).
REFRESH_TOKEN_TTL_DAYS=7
# bcrypt cost factor (10-15).
BCRYPT_ROUNDS=12

# ---- Logging ----
LOG_LEVEL=info
